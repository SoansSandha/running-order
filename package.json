{
  "name": "running-order",
  "version": "0.1.0",
  "description": "Sort a Spotify playlist into a lasting order, without losing when you added anything.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npm run dev",
    "dev": "concurrently -n web,proxy -c cyan,magenta -p \"[{name}]\" \"npm:dev:web\" \"npm:dev:proxy\"",
    "dev:web": "vite",
    "dev:proxy": "python -m uvicorn app:app --host 127.0.0.1 --port 8787 --app-dir proxy",
    "build": "vite build",
    "lint": "oxlint src",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/azeret-mono": "^5.3.0",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "papaparse": "^5.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "oxlint": "^1.79.0",
    "vite": "^8.2.2",
    "vitest": "^3.2.7"
  }
}
